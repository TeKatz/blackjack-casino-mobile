<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BlackjackCasino.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Blackjack Empire</ApplicationTitle>
    <ApplicationId>com.tekatz.blackjackcasino.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="../BlackjackCasino.Core/BlackjackCasino.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#10251F" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#10251F" BaseSize="128,128" />
  </ItemGroup>
</Project>
